<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SendEasy.App</RootNamespace>
    <AssemblyName>SendEasyBT</AssemblyName>
    <Product>שליחה קלה - BT</Product>
    <Version>0.1.0</Version>
    <StartupObject>SendEasy.App.Program</StartupObject>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SendEasy.Core\SendEasy.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\emoji\*.png" />
  </ItemGroup>

  <!-- בנייה מקומית: מספר הגרסה לפי התג האחרון בגיטאב (ב-CI מספר הגרסה נקבע בנפרד) -->
  <Target Name="DevVersionFromGit" BeforeTargets="GenerateAssemblyInfo;GetAssemblyVersion;GetAssemblyAttributes" Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <Exec Command="git tag --sort=-v:refname" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DevTags" />
    </Exec>
    <PropertyGroup Condition="'$(_DevTags)' != ''">
      <_DevTag>$([System.Text.RegularExpressions.Regex]::Match('$(_DevTags)', '^[^;]+').Value)</_DevTag>
      <_DevVer>$(_DevTag.Trim().TrimStart('v'))</_DevVer>
      <Version>$(_DevVer)</Version>
      <AssemblyVersion>$(_DevVer)</AssemblyVersion>
      <FileVersion>$(_DevVer)</FileVersion>
      <InformationalVersion>$(_DevVer)-dev</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
