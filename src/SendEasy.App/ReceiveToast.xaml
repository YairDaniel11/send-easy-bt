<Window x:Class="SendEasy.App.ReceiveToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="Height" Width="360"
        ShowActivated="False" FlowDirection="RightToLeft">
    <Grid Margin="10" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- הצל על שכבה נפרדת: אפקט על הבורדר עם הטקסט מרסטר אותו וגורם לטשטוש -->
    <Border CornerRadius="10" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
    </Border>
    <Border CornerRadius="10" Padding="14,12" UseLayoutRounding="True" SnapsToDevicePixels="True"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NameText" Opacity="0.75" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="Bar" Maximum="1000" Height="6"/>
                <TextBlock x:Name="InfoText" FontSize="12" Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>
            <ui:Button x:Name="CancelBtn" Grid.Column="1" Content="בטל" Margin="12,0,0,0"
                       VerticalAlignment="Center" Click="Cancel_Click"/>
        </Grid>
    </Border>
    </Grid>
</Window>
