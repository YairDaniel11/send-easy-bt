<ui:FluentWindow x:Class="SendEasy.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="עדכון" Width="460" Height="330" ResizeMode="NoResize"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="עדכון - שליחה קלה - BT" FlowDirection="LeftToRight" ShowMaximize="False" ShowMinimize="False"/>
        <StackPanel Grid.Row="1" Margin="26,10,26,0">
            <TextBlock x:Name="Head" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" Opacity="0.75" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="Notes" Opacity="0.65" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Status" Margin="0,16,0,6" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Bar" Maximum="1000" Height="6" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="26,10,26,20" HorizontalAlignment="Right">
            <ui:Button x:Name="LaterBtn" Content="אחר כך" MinWidth="90" Margin="0,0,8,0" Click="Later_Click"/>
            <ui:Button x:Name="InstallBtn" Content="הורד והתקן" Appearance="Primary" MinWidth="130" Click="Install_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>