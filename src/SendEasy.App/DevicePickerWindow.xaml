<ui:FluentWindow x:Class="SendEasy.App.DevicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="צ'אט חדש" Width="400" Height="480" ResizeMode="NoResize"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="צ'אט חדש" FlowDirection="LeftToRight" ShowMaximize="False" ShowMinimize="False"/>
        <TextBlock Grid.Row="1" Text="בחר מכשיר לצ'אט (גם מכשיר שכבר יש איתו שיחה)" Margin="22,8,22,8" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <ListBox x:Name="List" Grid.Row="2" Margin="16,0" MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="VerticalOnly">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" Opacity="0.65" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Status" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Margin="24"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="22,10,22,18" HorizontalAlignment="Right">
            <ui:Button x:Name="OkBtn" Content="פתח צ'אט" Appearance="Primary" MinWidth="100" IsEnabled="False" Click="Ok_Click" Margin="0,0,8,0"/>
            <ui:Button Content="ביטול" MinWidth="90" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>