<Window x:Class="SendEasy.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FlowDirection="RightToLeft" Deactivated="Window_Deactivated" KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- פריט תפריט שטוח: בלי מסגרת, רק הדגשה עדינה בריחוף -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Margin="0,1" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="10" Padding="6"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.2"/>
        </Border.Effect>
        <StackPanel MinWidth="250">
            <TextBlock Text="שליחה קלה - BT" FontWeight="SemiBold" FontSize="15" Margin="10,8,10,2"/>
            <TextBlock x:Name="StatusLine" Opacity="0.6" FontSize="12" Margin="10,0,10,8"/>
            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="4,0,4,4" Opacity="0.6"/>

            <Button Style="{StaticResource MenuRow}" Click="Send_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE724;"/>
                    <TextBlock Text="שלח קבצים..." VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="Chat_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;"/>
                    <TextBlock Text="צ'אט" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="History_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;"/>
                    <TextBlock Text="היסטוריה" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="Folder_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xED25;"/>
                    <TextBlock Text="תיקיית קבלה" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Grid Margin="10,6,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE702;"/>
                    <TextBlock Text="קבלת קבצים פעילה" VerticalAlignment="Center"/>
                </StackPanel>
                <ui:ToggleSwitch x:Name="ReceiveSwitch" Grid.Column="1" Click="Receive_Click"/>
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="4,2,4,4" Opacity="0.6"/>
            <Button Style="{StaticResource MenuRow}" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"/>
                    <TextBlock Text="הגדרות..." VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="About_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;"/>
                    <TextBlock Text="אודות" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="Exit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;"/>
                    <TextBlock Text="יציאה" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
