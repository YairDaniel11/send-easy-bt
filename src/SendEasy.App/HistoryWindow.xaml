<ui:FluentWindow x:Class="SendEasy.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="קבצים" Width="900" Height="640" MinWidth="620" MinHeight="420"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="קבצים - שליחה קלה - BT" FlowDirection="LeftToRight"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- סרגל מכשירים (בימין) -->
            <DockPanel Grid.Column="0" Margin="10,0,6,0">
                <TextBlock DockPanel.Dock="Top" Text="מכשירים" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="8,8,8,6"/>
                <ListBox x:Name="DevList" SelectionChanged="DevList_SelectionChanged" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- רשימת הקבצים -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,6,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="Heading" Text="כל המכשירים" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="CountText" FontSize="12" Opacity="0.65" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                    </StackPanel>
                    <ui:TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="חיפוש לפי שם קובץ" TextChanged="Search_TextChanged"/>
                </Grid>
                <StackPanel Grid.Row="1" Margin="12,0,12,8">
                    <WrapPanel x:Name="DirChips"/>
                    <WrapPanel x:Name="TypeChips" Margin="0,6,0,0"/>
                </StackPanel>

                <ListBox x:Name="List" Grid.Row="2" Margin="8,0,8,0" ScrollViewer.PanningMode="VerticalOnly"
                         MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="8,12,8,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{Binding IconBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Ext}" Foreground="White" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Arrow}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ArrowBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Grid.Row="2" Opacity="0.6" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,14">
            <ui:Button x:Name="OpenBtn" Content="פתח" Appearance="Primary" Click="Open_Click" MinWidth="80" Margin="0,0,8,0" IsEnabled="False" ToolTip="פותח את הקובץ או התיקייה"/>
            <ui:Button x:Name="ShowBtn" Content="הצג בתיקייה" Click="Show_Click" Margin="0,0,8,0" IsEnabled="False" ToolTip="פותח את סייר הקבצים ומסמן את הקובץ"/>
            <ui:Button x:Name="RemoveBtn" Content="הסר מהרשימה" Click="Remove_Click" Margin="0,0,8,0" IsEnabled="False" ToolTip="מסיר רק מהרשימה, הקובץ עצמו לא נמחק"/>
            <ui:Button Content="נקה הכל" Click="Clear_Click"/>
            <TextBlock x:Name="Hint" Opacity="0.65" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
