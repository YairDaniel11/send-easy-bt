<ui:FluentWindow x:Class="SendEasy.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="היסטוריה" Width="560" Height="600" MinWidth="420" MinHeight="360"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="היסטוריה - שליחה קלה - BT" FlowDirection="LeftToRight"/>
        <TextBlock Grid.Row="1" Text="היסטוריה" FontSize="22" FontWeight="Bold" Margin="20,8,20,8"/>

        <ListBox x:Name="List" ScrollViewer.PanningMode="VerticalOnly" Grid.Row="2" Margin="12,0" MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Arrow}" FontSize="20" VerticalAlignment="Center"
                                   Foreground="{Binding ArrowBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="עדיין אין היסטוריה" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,10,16,14">
            <ui:Button x:Name="OpenBtn" Content="פתח" Appearance="Primary" Click="Open_Click" MinWidth="80" Margin="0,0,8,0" IsEnabled="False" ToolTip="פותח את הקובץ או התיקייה"/>
            <ui:Button x:Name="ShowBtn" Content="הצג בתיקייה" Click="Show_Click" Margin="0,0,8,0" IsEnabled="False" ToolTip="פותח את סייר הקבצים ומסמן את הקובץ"/>
            <ui:Button Content="נקה היסטוריה" Click="Clear_Click"/>
            <TextBlock x:Name="Hint" Opacity="0.65" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
