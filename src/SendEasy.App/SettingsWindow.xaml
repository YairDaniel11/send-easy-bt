<ui:FluentWindow x:Class="SendEasy.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="הגדרות" Width="560" Height="680" MinHeight="420"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="הגדרות - שליחה קלה - BT" FlowDirection="LeftToRight" ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer PanningMode="VerticalOnly" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,8,22,12">
                <TextBlock Text="קבלת קבצים" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="שאל אותי על כל קובץ"/>
                    <ComboBoxItem Content="אוטומטית ממכשירים מצומדים, שאל על השאר"/>
                    <ComboBoxItem Content="אוטומטית מכולם"/>
                </ComboBox>

                <TextBlock Text="תיקיית קבלה" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirBox" FlowDirection="LeftToRight"/>
                    <ui:Button Grid.Column="1" Content="עיון..." Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>

                <TextBlock Text="קיצורי מקשים" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <CheckBox x:Name="HotkeyBox" Content="שלח את הקבצים שנבחרו בסייר"/>
                <TextBox x:Name="HotkeyText" IsReadOnly="True" Margin="0,4,0,0"/>
                <CheckBox x:Name="DirectBox" Margin="0,6,0,0" Content="שלח מיד למכשיר ברירת המחדל, בלי חלון בחירה"/>
                <CheckBox x:Name="ClipBox" Margin="0,10,0,0" Content="שלח טקסט או קישור מהלוח (כקובץ טקסט)"/>
                <TextBox x:Name="ClipText" IsReadOnly="True" Margin="0,4,0,0"/>
                <TextBlock Text="לחץ בתיבה ואז על הצירוף הרצוי. חובה לפחות Ctrl, Alt, Shift או Win."
                           Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>

                <TextBlock Text="מכשירים מועדפים" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <StackPanel x:Name="FavPanel"/>
                <TextBlock x:Name="FavEmpty" Opacity="0.6" TextWrapping="Wrap" FontSize="12"
                           Text="אין מועדפים. בחלון השליחה לחץ על הכוכב ☆ ליד מכשיר כדי להוסיף אותו."/>

                <TextBlock Text="עיצוב הצ&apos;אט" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <RadioButton x:Name="ChatWa" HorizontalAlignment="Left" GroupName="chatstyle" Content="ווטסאפ"/>
                <RadioButton x:Name="ChatGc" HorizontalAlignment="Left" GroupName="chatstyle" Content="גוגל צ&apos;אט"/>
                <RadioButton x:Name="ChatPaper" HorizontalAlignment="Left" GroupName="chatstyle" Content="כתבן"/>

                <TextBlock Text="הודעות" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <CheckBox x:Name="PopupBox" Content="הצג חלון קטן בפינה בכל הודעה חדשה ממכשיר"/>
                <CheckBox x:Name="SoundBox" Content="השמע צליל בעת קבלת הודעה"/>
                <TextBlock Text="מיקום החלון הקטן במסך (הודעות, קבלת קבצים ועדכונים)" Margin="0,8,0,4"/>
                <ComboBox x:Name="ToastPosBox" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="למטה מימין"/>
                    <ComboBoxItem Content="למטה במרכז"/>
                    <ComboBoxItem Content="למטה משמאל"/>
                    <ComboBoxItem Content="למעלה מימין"/>
                    <ComboBoxItem Content="למעלה במרכז"/>
                    <ComboBoxItem Content="למעלה משמאל"/>
                </ComboBox>

                <TextBlock Text="עדכון התוכנה" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <ui:Button x:Name="UpdBtn" Content="בדוק עדכון" HorizontalAlignment="Stretch" Click="Update_Click"/>
                <TextBlock x:Name="UpdStatus" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <TextBlock Text="אפליקציית אנדרואיד" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <ui:Button x:Name="ApkBtn" Content="הורד את אפליקציית האנדרואיד למחשב" HorizontalAlignment="Stretch" Click="Apk_Click"/>
                <ProgressBar x:Name="ApkBar" Maximum="1000" Height="5" Margin="0,8,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="ApkStatus" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="ארכיונים (ZIP)" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <CheckBox x:Name="OwnBox" Content="חלץ אוטומטית ארכיונים שנשלחו על ידי התוכנה (תיקיות)"/>
                <CheckBox x:Name="AllBox" Content="חלץ כל קובץ ZIP שמתקבל, גם אם לא נשלח על ידי התוכנה"/>
                <CheckBox x:Name="DelBox" Content="מחק את קובץ ה-ZIP אחרי חילוץ מוצלח"/>
                <TextBlock Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                           Text="החילוץ תמיד בטוח: נתיבים חשודים או ארכיון גדול מדי נדחים, ולעולם לא נדרס קובץ קיים."/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="22,10,22,16" HorizontalAlignment="Right">
            <ui:Button Content="ביטול" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80"/>
            <ui:Button Content="שמור" Appearance="Primary" Click="Save_Click" MinWidth="80"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
