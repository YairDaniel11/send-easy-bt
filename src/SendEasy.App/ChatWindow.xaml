<ui:FluentWindow x:Class="SendEasy.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="צ'אט - שליחה קלה - BT" Width="1000" Height="680" MinWidth="720" MinHeight="480"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="צ'אט - שליחה קלה - BT" FlowDirection="LeftToRight"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- רשימת שיחות -->
            <Border x:Name="SidePane" Grid.Column="0" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="18,14,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SideTitle" Text="צ'אטים" FontSize="22" FontWeight="Bold"/>
                        <ui:Button Grid.Column="1" Content="+ צ'אט חדש" Click="NewChat_Click" Padding="10,4"/>
                    </Grid>
                    <ui:TextBox Grid.Row="1" PlaceholderText="חיפוש שיחה" Margin="14,0,14,10"/>
                    <ListBox x:Name="ConvList" ScrollViewer.PanningMode="VerticalOnly" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="2" SelectionChanged="ConvList_SelectionChanged"
                             BorderThickness="0" Background="Transparent" Padding="6,0"/>
                </Grid>
            </Border>

            <!-- השיחה -->
            <Grid Grid.Column="1" x:Name="ChatPane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="HeaderBar" Grid.Row="0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HeaderAvatar" Width="42" Height="42" CornerRadius="21">
                            <TextBlock x:Name="HeaderInitial" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderName" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HeaderStatus" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="CancelSendBtn" Content="✖ בטל שליחה" Visibility="Collapsed"
                                VerticalAlignment="Center" Padding="10,4" Click="CancelSend_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer PanningMode="VerticalOnly" x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MsgPanel" FlowDirection="LeftToRight" Margin="0,10"/>
                </ScrollViewer>

                <Border x:Name="Composer" Grid.Row="2" Padding="12,10">
                    <StackPanel>
                    <Border x:Name="PendingPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="6" CornerRadius="10" HorizontalAlignment="Right"
                            Background="#22808080">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="PendingImg" MaxHeight="110" MaxWidth="220" Stretch="Uniform"/>
                            <Button Content="✖" Click="RemovePending_Click" VerticalAlignment="Top" Margin="6,0,0,0" Padding="6,2"
                                    Background="Transparent" BorderThickness="0" ToolTip="הסר את התמונה"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="AttachBtn" Content="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Width="42" Height="42"
                                Background="Transparent" BorderThickness="0" Click="Attach_Click" ToolTip="צרף קובץ"/>
                        <Border Grid.Column="1" x:Name="InputBox" CornerRadius="22" Padding="14,4" Margin="4,0">
                            <Grid>
                                <RichTextBox x:Name="Input" BorderThickness="0" Background="Transparent" AcceptsReturn="True" Padding="0"
                                         MaxHeight="110" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                         PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged">
                                    <RichTextBox.Resources>
                                        <Style TargetType="Paragraph"><Setter Property="Margin" Value="0"/></Style>
                                    </RichTextBox.Resources>
                                </RichTextBox>
                                <TextBlock x:Name="RecordLabel" Visibility="Collapsed" VerticalAlignment="Center" Foreground="#E53935"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" x:Name="EmojiBtn" Width="42" Height="42" FontSize="20" Margin="0,0,4,0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Click="Emoji_Click" Content="&#xE76E;" ToolTip="הוסף אייקון"/>
                        <Button Grid.Column="3" x:Name="PauseBtn" Width="44" Height="44" FontSize="16" Margin="0,0,4,0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" BorderThickness="0" Click="Pause_Click" Content="&#xE769;" ToolTip="השהה את ההקלטה" Visibility="Collapsed"/>
                        <Button Grid.Column="4" x:Name="ActionBtn" Width="44" Height="44" FontSize="18"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" BorderThickness="0" Click="Action_Click" Content="&#xE720;" ToolTip="הקלטת הודעה קולית"/>
                    </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
