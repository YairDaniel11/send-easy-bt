<ui:FluentWindow x:Class="SendEasy.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="אודות" Width="460" Height="490" ResizeMode="NoResize"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="אודות - שליחה קלה - BT" FlowDirection="LeftToRight" ShowMaximize="False" ShowMinimize="False"/>
        <StackPanel Grid.Row="1" Margin="28,10,28,0">
            <Image x:Name="Logo" Width="64" Height="64" HorizontalAlignment="Right" Margin="0,0,0,10"/>
            <TextBlock Text="שליחה קלה - BT" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Opacity="0.75" Margin="0,4,0,0"/>
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="22"
                       Text="שליחה וקבלת קבצים, תמונות, הקלטות והודעות בבלוטוס בין המחשב לטלפון. אפשר לשלוח כל קובץ או תיקייה בקליק ימני, וגם לקבל קבצים מהטלפון במחשבים שבהם Windows לא מצליח לקבל אותם. מתאימה גם למכשירי מקשים."/>
            <TextBlock Margin="0,16,0,2" Opacity="0.7" Text="מאגר התוכנה ב-GitHub:"/>
            <TextBlock>
                <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/YairDaniel11/send-easy-bt" RequestNavigate="Repo_Navigate">
                    <Run Text="github.com/YairDaniel11/send-easy-bt" FlowDirection="LeftToRight"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>
        <ui:Button Grid.Row="2" Content="סגור" Appearance="Primary" MinWidth="100" HorizontalAlignment="Left"
                   Margin="28,10,28,20" Click="Close_Click"/>
    </Grid>
</ui:FluentWindow>