<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sbBg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/sbHeader"
        android:padding="12dp"
        android:text="@string/send_title"
        android:textColor="@color/header_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/sendStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/sbText"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/sendName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="?attr/sbTextSecondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/sendBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="14dp"
            android:max="100" />

        <TextView
            android:id="@+id/sendInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/sbTextSecondary"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/sendCancel"
        style="@style/ActionButton"
        android:layout_margin="12dp"
        android:nextFocusDown="@id/sendCancel"
        android:nextFocusUp="@id/sendCancel"
        android:text="@string/send_cancel" />

    <TextView
        android:id="@+id/sendHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/sbRow"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/send_hint_cancel"
        android:textColor="?attr/sbTextSecondary"
        android:textSize="11sp" />
</LinearLayout>