<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sbBg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/browserPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/sbHeader"
        android:ellipsize="start"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/header_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/browserList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#22888888"
            android:dividerHeight="1dp"
            android:drawSelectorOnTop="true"
            android:listSelector="@drawable/list_selector" />

        <TextView
            android:id="@+id/browserEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/browser_empty"
            android:textColor="?attr/sbTextSecondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/browserCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/sbRow"
        android:padding="6dp"
        android:textColor="?attr/sbAccent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/browserHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/sbRow"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/browser_hint"
        android:textColor="?attr/sbTextSecondary"
        android:textSize="11sp" />
</LinearLayout>